{
  "name": "HURDLER web designer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -e '.[notebooks,optimization]'",
  "postAttachCommand": "bash -lc 'pgrep -f \"marimo run.*hurdler_designer.py\" >/dev/null || nohup hurdler web --host 0.0.0.0 --port 2718 --no-browser >/tmp/hurdler-web.log 2>&1 &'",
  "forwardPorts": [2718],
  "portsAttributes": {
    "2718": {
      "label": "HURDLER designer",
      "onAutoForward": "openBrowser"
    }
  }
}
